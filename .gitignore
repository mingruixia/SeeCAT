# Release archives
*.zip

# MATLAB autosave / backups
*.asv
*~

# OS
.DS_Store
Thumbs.db

# dcm2niix binaries: added by the release script, not kept in git
external/dcm2niix/*/

# Release builds (tools/make_release.m) and local screenshots
build/
Doc/screenshots/

# PDF manuals: built by Doc/manual/src/build.py --pdf and added by the release script,
# with the stamp that ties them to the committed manual sources
Doc/manual/*.pdf
Doc/manual/pdf_build.json

# Daily review reports from the user (read by the scheduled review task)
review/
